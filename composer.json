{
    "name": "elife/logging-sdk",
    "description": "eLife Sciences logging SDK",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "eLife\\Logging\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\eLife\\Logging\\": "./test"
        }
    },
    "require": {
        "php": "^8.2",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0"
    },
    "require-dev": {
        "crell/api-problem": "^2.0 || ^3.0",
        "elife/api-problem": "^1.0",
        "mikey179/vfsstream": "^1.6.11",
        "phpunit/phpunit": "^12.5.0",
        "squizlabs/php_codesniffer": "^3.5",
        "symfony/browser-kit": "^7.0",
        "symfony/error-handler": "^7.0"
    },
    "suggest": {
        "crell/api-problem": "^2.0 || ^3.0, to use LoggingBundle with ApiProblem level detection",
        "elife/api-problem": "^1.0, to use LoggingBundle with ApiProblem level detection"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
